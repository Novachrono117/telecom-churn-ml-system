# Normalize every text file to LF, both in the repository and in the working
# tree, so Windows, Linux and Google Colab check out byte-identical content.
# This overrides any local core.autocrlf setting.
* text=auto eol=lf

# Binary formats must never be line-ending normalized.
*.png binary
*.jpg binary
*.pdf binary
*.joblib binary

# The raw source file is versioned and must stay byte-identical on every
# platform: its SHA-256 is the provenance recorded in `data/README.md`, and any
# line-ending normalization would silently invalidate it. `binary` (implying
# `-text`) disables that rewriting even though the file is plain CSV.
data/raw/** binary
