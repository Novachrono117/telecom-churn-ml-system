# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments / uv ---
.venv/
venv/
env/
.uv/
# uv.lock IS versioned on purpose (reproducibility). Do not ignore it.

# --- Testing / linting / typing caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Data ---
# Data is never committed: it is acquired and rebuilt reproducibly by code.
# `data/*` (not `data/`) so that the documentation below can be re-included:
# git does not descend into an ignored directory, which would make the
# negation unreachable.
data/*
!data/README.md
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.db
*.sqlite3

# --- ML artifacts (model binaries, regenerated by training) ---
artifacts/
*.pkl
*.joblib
*.onnx
*.h5
mlruns/

# NOTE: `reports/` is intentionally NOT ignored. Figures and result tables are
# deliverables (academic report + GitHub portfolio) and must stay versioned.

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Editors / OS ---
# Machine-local Claude Code settings: must not rely on a global core.excludesfile
# to stay out of the repository.
.claude/settings.local.json
.vscode/
.idea/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
