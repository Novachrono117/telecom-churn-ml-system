# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments / uv ---
.venv/
venv/
env/
.uv/
# uv.lock IS versioned on purpose (reproducibility). Do not ignore it.

# --- Testing / linting / typing caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Data ---
# `data/*` (not `data/`) so that the entries below can be re-included: git does
# not descend into an ignored directory, which would make a negation unreachable.
data/*
!data/README.md
# The raw source file IS versioned. It is small (<1 MB), immutable, and is the
# single input every recorded result is traceable to, so a fresh clone can
# rebuild the whole pipeline without a Kaggle account.
!data/raw/
# Derived layers stay out: they are regenerated by code, not carried around.
data/interim/
data/processed/
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.db
*.sqlite3
# Re-include the raw file, which the `*.csv` rule above would otherwise catch.
!data/raw/*.csv

# --- ML artifacts ---
# The frozen inference pipeline IS versioned: it is small (~8 KB) and is the
# deliverable another machine needs in order to serve predictions without
# retraining. Experiment scratch output and tracking stores stay out.
*.pkl
*.joblib
*.onnx
*.h5
mlruns/
!artifacts/model/*.joblib

# NOTE: `reports/` is intentionally NOT ignored. Figures and result tables are
# deliverables (academic report + GitHub portfolio) and must stay versioned.

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Editors / OS ---
# Machine-local Claude Code settings: must not rely on a global core.excludesfile
# to stay out of the repository.
.claude/settings.local.json
.vscode/
.idea/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
